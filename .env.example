# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# ENVIRONMENT CONFIGURATION - Development
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 
# Sao chép file này thành .env.local và cập nhật giá trị
# để phù hợp với môi trường phát triển của bạn.
#
# Copy this file to .env.local and update values for your environment
#

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# API CONFIGURATION / CẤU HÌNH API
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Base URL for API requests
# Localhost development: http://localhost:3000/api
# Production: https://api.algoquestcli.com
VITE_API_BASE_URL=http://localhost:3000/api

# Development mode flag
VITE_DEV_MODE=true

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# APPLICATION CONFIGURATION / CẤU HÌNH ỨNG DỤNG
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Application name
VITE_APP_NAME=AlgoQuest CLI

# Application version
VITE_APP_VERSION=1.0.0

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# FEATURE FLAGS / CỜ TÍNH NĂNG
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Enable multiplayer features
VITE_ENABLE_MULTIPLAYER=true

# Enable leaderboards
VITE_ENABLE_LEADERBOARDS=true

# Enable achievements system
VITE_ENABLE_ACHIEVEMENTS=true

# Enable analytics tracking
VITE_ENABLE_ANALYTICS=false

# Enable debug console (only in development)
VITE_ENABLE_DEBUG=true
